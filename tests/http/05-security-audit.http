# Security audit fixes (2026-08-24)
# Run against gateway with auth + trip from branch fix/security-audit-2026-08-24
# (restart both services from .worktrees/security — stale trip binaries skip H1/M1).
# Select the `dev` env in Kulala.
#
# Covers:
#   H1 — trip rejects JWT after session logout
#   M1 — trip ignores ?token= query auth (Bearer only)
#   M3 — login rate limit after 4 failed attempts (run last — locks customer for 15m)
#   M7 — admin DELETE /user/:id targets path id, not caller

### LOGIN_FOR_TRIP_SESSION
# H1 + M1 setup
POST {{base_url}}/api/auth/login HTTP/1.1
Content-Type: application/json
Accept: application/json
User-Agent: go-ojol-http-tests/security-trip

{
	"email": "{{auth_email}}",
	"password": "{{auth_password}}"
}

> {%
  const data = response.body.data;
  client.global.set("security_access_token", data.access_token);
  client.log("security_access_token stored");
%}

###

### TRIP_PROTECTED_BEARER_OK
# H1: valid session + Bearer should reach trip
GET {{base_url}}/api/trip/protected HTTP/1.1
Accept: application/json
Authorization: Bearer {{security_access_token}}

> {%
  client.assert(response.status === 200, "expected 200 with Bearer on trip");
%}

###

### TRIP_QUERY_TOKEN_SHOULD_FAIL
# M1: ?token= must not authenticate (Bearer-only).
# Drop leftover Authorization from the previous request — Kulala reuses it otherwise.
< {%
  try { request.headers.remove("Authorization"); } catch (e) {}
  try { request.headers.delete("Authorization"); } catch (e) {}
%}
GET {{base_url}}/api/trip/protected?token={{security_access_token}} HTTP/1.1
Accept: application/json
Authorization:

> {%
  client.assert(response.status === 401, "expected 401 for query-string token, got " + response.status);
%}

###

### LOGOUT_FOR_TRIP_SESSION
POST {{base_url}}/api/auth/logout HTTP/1.1
Accept: application/json
Authorization: Bearer {{security_access_token}}

> {%
  client.assert(response.status === 200, "expected 200 on logout");
%}

###

### TRIP_PROTECTED_AFTER_LOGOUT_SHOULD_FAIL
# H1: revoked session must fail on trip even if JWT not expired
GET {{base_url}}/api/trip/protected HTTP/1.1
Accept: application/json
Authorization: Bearer {{security_access_token}}

> {%
  client.assert(response.status === 401, "expected 401 on trip after session revoke, got " + response.status);
%}

###

### LOGIN_ADMIN
# M7 setup
POST {{base_url}}/api/auth/login HTTP/1.1
Content-Type: application/json
Accept: application/json
User-Agent: go-ojol-http-tests/security-admin

{
	"email": "{{admin_email}}",
	"password": "{{admin_password}}"
}

> {%
  client.global.set("admin_access_token", response.body.data.access_token);
  client.log("admin_access_token stored");
%}

###

### ADMIN_ME_BEFORE_DELETE
GET {{base_url}}/api/auth/user/me HTTP/1.1
Accept: application/json
Authorization: Bearer {{admin_access_token}}

> {%
  client.assert(response.status === 200, "admin /me should work before delete");
  client.global.set("admin_user_id", response.body.data.id);
%}

###

### ADMIN_DELETE_NONEXISTENT_USER
# M7: DELETE must use path :id — admin must not delete themselves when id differs
DELETE {{base_url}}/api/auth/user/00000000-0000-0000-0000-000000000000 HTTP/1.1
Accept: application/json
Authorization: Bearer {{admin_access_token}}

> {%
  client.assert(response.status === 400, "expected 400 deleting unknown user id, got " + response.status);
  client.assert(response.body.error === "user not found", "expected user not found");
%}

###

### ADMIN_ME_AFTER_DELETE_ATTEMPT
GET {{base_url}}/api/auth/user/me HTTP/1.1
Accept: application/json
Authorization: Bearer {{admin_access_token}}

> {%
  client.assert(response.status === 200, "admin must still exist after DELETE on another id, got " + response.status);
  client.assert(
    String(response.body.data.id) === String(client.global.get("admin_user_id")),
    "admin id unchanged"
  );
%}

###

### LOGIN_RATE_LIMIT_FAIL_1
# M3: wrong password (expect invalid credentials). Run after other tests — locks customer 15m.
POST {{base_url}}/api/auth/login HTTP/1.1
Content-Type: application/json
Accept: application/json

{
	"email": "{{auth_email}}",
	"password": "{{wrong_password}}"
}

> {%
  client.assert(response.status === 400, "attempt 1 expected 400");
  client.assert(response.body.error === "invalid credentials", "expected invalid credentials");
%}

###

### LOGIN_RATE_LIMIT_FAIL_2
POST {{base_url}}/api/auth/login HTTP/1.1
Content-Type: application/json
Accept: application/json

{
	"email": "{{auth_email}}",
	"password": "{{wrong_password}}"
}

> {%
  client.assert(response.status === 400, "attempt 2 expected 400");
%}

