### LOGIN_RATE_LIMIT_FAIL_4
POST {{base_url}}/api/auth/login HTTP/1.1
Content-Type: application/json
Accept: application/json

{
	"email": "{{auth_email}}",
	"password": "{{wrong_password}}"
}

> {%
  client.assert(response.status === 400, "attempt 4 expected 400");
%}

###

### LOGIN_RATE_LIMIT_BLOCKED
# Expect 429 on the 5th failure for the same IP + email
POST {{base_url}}/api/auth/login HTTP/1.1
Content-Type: application/json
Accept: application/json

{
	"email": "{{auth_email}}",
	"password": "{{wrong_password}}"
}

> {%
  client.assert(response.status === 429, "expected 429 after 4 failed logins");
  client.assert(
    response.body.error === "too many failed login attempts",
    "expected rate-limit error message"
  );
%}

###
